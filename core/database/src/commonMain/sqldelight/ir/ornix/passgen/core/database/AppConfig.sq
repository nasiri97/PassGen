CREATE TABLE IF NOT EXISTS appConfigEntity (
    id INTEGER PRIMARY KEY NOT NULL CHECK (id = 1),
    is_first_launch INTEGER NOT NULL DEFAULT 1,
    language TEXT NOT NULL DEFAULT 'en',
    theme TEXT NOT NULL DEFAULT 'system',
    is_copy_enabled INTEGER NOT NULL DEFAULT 0,
    visibility_timeout TEXT NOT NULL DEFAULT '30s'
);

INSERT OR IGNORE INTO appConfigEntity (id, is_first_launch, language, theme, is_copy_enabled, visibility_timeout)
VALUES (1, 1, 'en', 'system', 0, '30s');

selectAppConfig:
SELECT * FROM appConfigEntity WHERE id = 1;

updateFirstLaunch:
UPDATE appConfigEntity SET is_first_launch = ? WHERE id = 1;

updateLanguage:
UPDATE appConfigEntity SET language = ? WHERE id = 1;

updateTheme:
UPDATE appConfigEntity SET theme = ? WHERE id = 1;

updateCopyEnabled:
UPDATE appConfigEntity SET is_copy_enabled = ? WHERE id = 1;

updateVisibilityTimeout:
UPDATE appConfigEntity SET visibility_timeout = ? WHERE id = 1;
