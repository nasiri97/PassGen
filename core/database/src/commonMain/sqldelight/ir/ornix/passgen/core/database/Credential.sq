CREATE TABLE IF NOT EXISTS credentialEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    title TEXT,
    description TEXT,
    password_value TEXT NOT NULL,
    password_entropy_byte_size INTEGER,
    username TEXT,
    email TEXT,
    phone TEXT,
    associated_package_names TEXT NOT NULL DEFAULT '',
    associated_web_domains TEXT NOT NULL DEFAULT '',
    associated_keywords TEXT NOT NULL DEFAULT ''
);

insertCredential:
INSERT INTO credentialEntity(id, title, description, password_value, password_entropy_byte_size, username, email, phone, associated_package_names, associated_web_domains, associated_keywords)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertCredentialAutoId:
INSERT INTO credentialEntity(title, description, password_value, password_entropy_byte_size, username, email, phone, associated_package_names, associated_web_domains, associated_keywords)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateCredential:
UPDATE credentialEntity
SET title = ?, description = ?, password_value = ?, password_entropy_byte_size = ?, username = ?, email = ?, phone = ?, associated_package_names = ?, associated_web_domains = ?, associated_keywords = ?
WHERE id = ?;

deleteCredentialById:
DELETE FROM credentialEntity
WHERE id = ?;

selectAllCredentials:
SELECT * FROM credentialEntity;

selectCredentialById:
SELECT * FROM credentialEntity WHERE id = ?;
