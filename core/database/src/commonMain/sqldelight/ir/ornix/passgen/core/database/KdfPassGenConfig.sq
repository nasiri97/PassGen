CREATE TABLE IF NOT EXISTS kdfPassGenConfigEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    password_length INTEGER,
    pass_encoder_key TEXT NOT NULL,
    input_hasher_key TEXT NOT NULL,
    master_key_digest_id TEXT NOT NULL,
    trim_spaces INTEGER NOT NULL DEFAULT 1,
    collapse_spaces INTEGER NOT NULL DEFAULT 1,
    convert_lowercase INTEGER NOT NULL DEFAULT 1
);

insertConfigWithId:
INSERT INTO kdfPassGenConfigEntity (id, name, password_length, pass_encoder_key, input_hasher_key, master_key_digest_id, trim_spaces, collapse_spaces, convert_lowercase)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertConfigAutoId:
INSERT INTO kdfPassGenConfigEntity (name, password_length, pass_encoder_key, input_hasher_key, master_key_digest_id, trim_spaces, collapse_spaces, convert_lowercase)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

doesMasterKeyDigestIdExist:
SELECT EXISTS(
    SELECT 1
    FROM kdfPassGenConfigEntity
    WHERE master_key_digest_id = ?
);

selectAllMasterKeyDigestIds:
SELECT master_key_digest_id FROM kdfPassGenConfigEntity;

deleteConfigById:
DELETE FROM kdfPassGenConfigEntity WHERE id = ?;

selectConfigById:
SELECT * FROM kdfPassGenConfigEntity
WHERE id = ?;

selectAllConfigs:
SELECT * FROM kdfPassGenConfigEntity;

deleteAllConfigs:
DELETE FROM kdfPassGenConfigEntity;